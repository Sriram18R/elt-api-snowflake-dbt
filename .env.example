# ELT API Snowflake DBT - Environment Configuration
# Copy this file to .env and populate with your actual values
# NEVER commit .env to version control

# ============================================================================
# EXECUTION MODE
# ============================================================================
# Options: local (DuckDB) | snowflake (Snowflake Cloud)
EXECUTION_MODE=local

# ============================================================================
# API CONFIGURATION (OpenWeather / Public API)
# ============================================================================
# Base URL for weather API (free tier, no auth required)
API_BASE_URL=https://api.weatherapi.com/v1
API_TIMEOUT_SECONDS=30
MAX_RETRIES=3
BACKOFF_FACTOR=1.5

# ============================================================================
# LOCAL STORAGE (DuckDB - Development)
# ============================================================================
# Path to local DuckDB warehouse database file
LOCAL_DB_PATH=./data/local_warehouse.duckdb

# ============================================================================
# SNOWFLAKE CONFIGURATION (Production)
# ============================================================================
# Replace with your Snowflake account details
# Format for SNOWFLAKE_ACCOUNT: xy12345.us-east-1 (not snowflakecomputing.com)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=ELT_ROLE
SNOWFLAKE_WAREHOUSE=ELT_WH
SNOWFLAKE_DATABASE=ANALYTICS
SNOWFLAKE_SCHEMA=raw_weather

# ============================================================================
# LOGGING
# ============================================================================
# Options: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Options: json | text
LOG_FORMAT=json
# Log file path
LOG_FILE_PATH=./logs/ingestion.log

# ============================================================================
# DBT CONFIGURATION
# ============================================================================
# DBT profiles directory (for Snowflake connection)
DBT_PROFILES_DIR=./dbt_project/profiles
# DBT target (development | production)
DBT_TARGET=development
# Number of threads for parallel model execution
DBT_THREADS=4

# ============================================================================
# DATA VALIDATION
# ============================================================================
# Enable strict validation (fail on any invalid record)
STRICT_VALIDATION=false
# Maximum allowed temperature (Celsius) - anomaly detection
MAX_TEMPERATURE_C=60
# Minimum allowed temperature (Celsius)
MIN_TEMPERATURE_C=-60
# Maximum null rate allowed (%) before pipeline fails
MAX_NULL_RATE_PERCENT=5

# ============================================================================
# DUPLICATE DETECTION
# ============================================================================
# Enable duplicate detection and handling
DETECT_DUPLICATES=true
# Options: skip | update | error
ON_DUPLICATE_ACTION=update

# ============================================================================
# OPTIONAL: MONITORING & ALERTING
# ============================================================================
# Slack webhook for alerts (optional)
SLACK_WEBHOOK_URL=
# Email recipient for data quality reports
ALERT_EMAIL=

# ============================================================================
# OPTIONAL: PERFORMANCE TUNING
# ============================================================================
# Batch size for loading (rows per batch)
BATCH_SIZE=1000
# Number of parallel loaders
PARALLEL_LOADERS=2
