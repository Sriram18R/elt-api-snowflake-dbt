EXECUTION_MODE=local
LOG_LEVEL=INFO
DATA_DIR=data

# API Configuration
API_BASE_URL=https://api.example.com
API_TIMEOUT=30
API_MAX_RETRIES=3
API_RETRY_DELAY=5
API_KEY=your_api_key_here

# Snowflake Configuration (if EXECUTION_MODE=snowflake)
SNOWFLAKE_ACCOUNT=your_account
SNOWFLAKE_USER=your_user
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=ANALYTICS
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_ROLE=ANALYST

# DuckDB Configuration (if EXECUTION_MODE=local)
DUCKDB_PATH=data/local_warehouse.duckdb

# Validation Configuration
VALIDATION_STRICT_MODE=true
VALIDATION_ALLOW_NULL_REQUIRED=false
VALIDATION_MAX_ERRORS=100

# Transformation Configuration
TRANSFORM_NORMALIZE_CASE=true
TRANSFORM_REMOVE_DUPLICATES=true
TRANSFORM_HANDLE_NULLS=true

# Loader Configuration
LOADER_BATCH_SIZE=1000
LOADER_UPSERT_ENABLED=true
LOADER_TRUNCATE_BEFORE_LOAD=false
LOADER_CREATE_TABLES_IF_MISSING=true
